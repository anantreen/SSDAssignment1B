{
  "SearchSessions": {
    "validator": {
      "bsonType": "object",
      "required": ["location", "created_at"],
      "properties": {
        "location": {
          "bsonType": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "enum": ["Point"]
            },
            "coordinates": {
              "bsonType": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "bsonType": ["double", "int", "long", "decimal"]
              }
            }
          }
        },
        "created_at": {
          "bsonType": "date"
        },
        "session_id": {
          "bsonType": "string"
        },
        "user_device": {
          "bsonType": "string"
        }
      }
    },
    "indexes": ["idx_sessions_geo_recent", "idx_sessions_ttl (7200 seconds)"]
  },
  "PropertyReviews": {
    "validator": {
      "bsonType": "object",
      "required": ["property_id", "guest_id", "rating", "location_tags", "timestamp"],
      "properties": {
        "property_id": {
          "bsonType": "int",
          "minimum": 1
        },
        "guest_id": {
          "bsonType": "int",
          "minimum": 1
        },
        "rating": {
          "bsonType": "int",
          "minimum": 1,
          "maximum": 5
        },
        "location_tags": {
          "bsonType": "array",
          "items": {
            "bsonType": "string"
          }
        },
        "timestamp": {
          "bsonType": "date"
        },
        "review_text": {
          "bsonType": "string"
        }
      }
    },
    "indexes": ["idx_reviews_property_time"]
  },
  "PropertyAmenities": {
    "validator": {
      "bsonType": "object",
      "required": ["property_id", "house_rules", "accessibility_features"],
      "properties": {
        "property_id": {
          "bsonType": "int",
          "minimum": 1
        },
        "house_rules": {
          "bsonType": "array",
          "items": {
            "bsonType": "string"
          }
        },
        "accessibility_features": {
          "bsonType": "array",
          "items": {
            "bsonType": "string"
          }
        },
        "amenities": {
          "bsonType": "object"
        }
      }
    },
    "indexes": ["idx_amenities_property (unique)"]
  }
}
