# Portable defaults for a fresh local installation (sample credentials only).
# DATABASE_URL is read by the API, psql and PostgreSQL/Python seeders.
DATABASE_URL=postgresql://stayspot:stayspot@127.0.0.1:5432/stayspot
# MONGO_URL selects the MongoDB server; MONGO_DB selects its logical database.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=stayspot
# Compose host ports must also match DATABASE_URL / MONGO_URL when overridden.
POSTGRES_PORT=5432
MONGO_PORT=27017
# HTTP listener used by npm start; the development UI proxies to this server.
PORT=3000
